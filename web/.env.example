# ==========================================
# ThermoGuard Environment Configuration
# ==========================================

# MongoDB Connection String:
# Option A (Standard Replica Set - recommended if local DNS blocks SRV queries):
# MONGODB_URI=mongodb://<user>:<password>@ac-twmjbyl-shard-00-00.na4cjkn.mongodb.net:27017,ac-twmjbyl-shard-00-01.na4cjkn.mongodb.net:27017,ac-twmjbyl-shard-00-02.na4cjkn.mongodb.net:27017/thermoguard?ssl=true&replicaSet=atlas-clhuvu-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Option B (SRV format for cloud deployments like Vercel):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.na4cjkn.mongodb.net/thermoguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/thermoguard

# MongoDB Database Name
MONGODB_DB_NAME=thermoguard

# Pre-shared Device Authentication Secret
DEVICE_API_TOKEN=your_secure_random_device_token_here

# Default Target Device Identifier
DEVICE_ID=thermoguard-01

# Public Application URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
